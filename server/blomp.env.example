# DUMMY ONLY. Server secrets, never NEXT_PUBLIC_. OFF does not instantiate a client.
BLOMP_ENABLED=false
BLOMP_ENDPOINT=https://storage.blomp.com
BLOMP_REGION=us-east-1
BLOMP_BUCKET=dummy-account@example.invalid
BLOMP_ACCESS_KEY_ID=dummy-access-key
BLOMP_SECRET_ACCESS_KEY=dummy-secret-key

# Phase 2 isolated development gates. The production API leaves Blomp disabled.
BLOMP_MULTIPART_ENABLED=false
BLOMP_BROWSER_TRANSFER_ENABLED=false
BLOMP_FREE_LIMITS_CONFIRMED=false
