{
  "name": "axfluxo-video-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node ../work/video-server/api.mjs",
    "test": "vitest run --root .. server/tests",
    "dev": "tsx api/main.ts",
