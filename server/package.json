  },
  "dependencies": {
    "jose": "6.2.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
