{
  "name": "axfluxo-video-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node ../work/video-server/api.mjs",
    "test": "vitest run --root .. server/tests",
    "dev": "tsx api/main.ts",
    "build": "esbuild api/main.ts --bundle --platform=node --target=node24 --packages=external --format=esm --outfile=../work/video-server/api.mjs",
    "build:probe": "esbuild worker/probe/main.ts --bundle --platform=node --target=node24 --packages=external --format=esm --outfile=../work/video-server/probe.mjs",
    "probe": "node ../work/video-server/probe.mjs",
    "build:derivatives": "esbuild worker/derivatives/main.ts --bundle --platform=node --target=node24 --packages=external --format=esm --outfile=../work/video-server/derivatives.mjs",
    "derivatives": "node ../work/video-server/derivatives.mjs",
    "build:render": "esbuild worker/render/main.ts --bundle --platform=node --target=node24 --packages=external --format=esm --outfile=../work/video-server/render.mjs",
    "render": "node ../work/video-server/render.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
