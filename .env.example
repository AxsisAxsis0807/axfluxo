NEXT_PUBLIC_SUPABASE_URL=https://nbyigfqkweodzlhwdryz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Public origin of the standalone developer video API (no path).
NEXT_PUBLIC_VIDEO_API_ORIGIN=

# Google Drive Phase 1 (server only; disabled until manually configured)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=replace-in-Blitz-secret-settings-only
# 32 random bytes in standard Base64. Dummy placeholder, never use in production.
GOOGLE_DRIVE_TOKEN_KEY=replace-with-secure-32-byte-base64-key
GOOGLE_DRIVE_PUBLIC_ORIGIN=https://axsis.prod.page

# Exact static frontend diagnostic URL (including any basePath), no query/fragment
GOOGLE_DRIVE_FRONTEND_URL=https://frontend.example/developer/video/

# Drive Cloud Phases 2-6. Keep OFF until separate operational approval and G0-G4 checks.
NEXT_PUBLIC_DRIVE_CLOUD_UI=false
DRIVE_CLOUD_ENABLED=false
DRIVE_CLOUD_TERMS_CONFIRMED=false
# Must remain false until actual worker memory/disk/sleep measurements are approved.
DRIVE_CLOUD_RESOURCES_VERIFIED=false
# Total monthly tax-inclusive fixed estimate, all services combined. Unknown=501 => OFF.
DRIVE_CLOUD_MONTHLY_YEN=501
DRIVE_CLOUD_LIMIT_BYTES=10737418240
DRIVE_CLOUD_MARGIN_BYTES=268435456
DRIVE_CLOUD_MAX_FILE_BYTES=2147483648
# Unknown DB cap keeps production Cloud OFF. Set only after validating the actual provider limit.
DRIVE_CLOUD_DB_LIMIT_BYTES=0
DRIVE_CLOUD_1440_VERIFIED=false
# Production Drive Cloud additionally requires existing VIDEO_DATABASE_TLS=verify-full
# and VIDEO_DATABASE_CA. No TLS weakening; no-TLS providers remain held.
# Worker uses the existing VIDEO_WORKER_ENABLED/VIDEO_RENDER_ENABLED/disk/compute budgets.
# Legacy temporary DB export: automatic retention deletion is OFF; separate approval required.
EXPORT_RETENTION_PURGE_ENABLED=false
EXPORT_RETENTION_DELETION_APPROVED=false
